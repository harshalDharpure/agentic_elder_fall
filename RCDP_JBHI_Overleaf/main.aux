\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces \textbf  {Fixed-threshold control.} Threshold $\tau ^\ast {=}1/(\beta {+}1){=}0.091$ for $\beta {=}10$, without deferral (SisFall, $n{=}1000$/fold). Bayes optimality requires calibrated posteriors; better empirically tuned thresholds are not ruled out. Values marked $^\dagger $ are approximate plug-in estimates from rounded aggregate F1, recall and main-run prevalence, not fold-wise measurements. All stack classification metrics use main-ablation counts, as in Table\nobreakspace  {}\ref  {tab:meanstd}; escalation is from the separate timing run.}}{7}{table.6}\protected@file@percent }
\newlabel{tab:partitionfallback}{{VI}{7}{\textbf {Fixed-threshold control.} Threshold $\tau ^\ast {=}1/(\beta {+}1){=}0.091$ for $\beta {=}10$, without deferral (SisFall, $n{=}1000$/fold). Bayes optimality requires calibrated posteriors; better empirically tuned thresholds are not ruled out. Values marked $^\dagger $ are approximate plug-in estimates from rounded aggregate F1, recall and main-run prevalence, not fold-wise measurements. All stack classification metrics use main-ablation counts, as in Table~\ref {tab:meanstd}; escalation is from the separate timing run}{table.6}{}}
