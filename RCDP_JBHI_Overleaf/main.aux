\@writefile{lot}{\contentsline {table}{\numberline {IX}{\ignorespaces \textbf  {Negative result.} Naive label-flip Actor--Critic (\texttt  {gate\_knn\_llm\_actor\_critic}) versus the primary stack on SisFall ($n{=}1000$/fold). Permitting the Critic to veto fall predictions inflates false negatives by an order of magnitude, which is the exact failure mode an FN-heavy cost penalises. Both columns come from one paired actor--critic run; its \texttt  {gate\_knn\_llm} column differs by ${\le }0.022$ F1 from Table\nobreakspace  {}\ref  {tab:perfold} because local-LLM decoding is non-deterministic.}}{8}{table.9}\protected@file@percent }
\newlabel{tab:negative}{{IX}{8}{\textbf {Negative result.} Naive label-flip Actor--Critic (\texttt {gate\_knn\_llm\_actor\_critic}) versus the primary stack on SisFall ($n{=}1000$/fold). Permitting the Critic to veto fall predictions inflates false negatives by an order of magnitude, which is the exact failure mode an FN-heavy cost penalises. Both columns come from one paired actor--critic run; its \texttt {gate\_knn\_llm} column differs by ${\le }0.022$ F1 from Table~\ref {tab:perfold} because local-LLM decoding is non-deterministic}{table.9}{}}
