\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Per-fold comparison of the frozen primary detector (\texttt  {primary\_only}) against the full stack (\texttt  {gate\_knn\_llm}) on SisFall: $n{=}1000$ stratified windows per fold with forced D18/D19 coverage, subject-independent folds, identical checkpoints. Cost is $10\cdot \mathrm  {FN}{+}\mathrm  {FP}$ per $1000$ windows. The stack improves F1, recall and cost on every fold; deltas use the displayed rounded values; paired intervals are in Table\nobreakspace  {}\ref  {tab:meanstd}.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:perfold}{{II}{6}{Per-fold comparison of the frozen primary detector (\texttt {primary\_only}) against the full stack (\texttt {gate\_knn\_llm}) on SisFall: $n{=}1000$ stratified windows per fold with forced D18/D19 coverage, subject-independent folds, identical checkpoints. Cost is $10\cdot \mathrm {FN}{+}\mathrm {FP}$ per $1000$ windows. The stack improves F1, recall and cost on every fold; deltas use the displayed rounded values; paired intervals are in Table~\ref {tab:meanstd}}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces SisFall main protocol, five-fold mean$\pm $sample std ($n{=}1000$/fold, fall prevalence $0.433{\pm }0.004$), computed from the counts in Table\nobreakspace  {}\ref  {tab:confusion} before rounding. Paired intervals are fold-level percentile bootstrap ($10^4$ resamples, seed $42$); BCa intervals are F1 $[0.117,0.154]$, recall $[0.181,0.244]$, cost $[-1084,-834]$. The exact two-sided Wilcoxon $p$ is $0.0625$ for every metric (the minimum attainable with five pairs). Five overlapping folds make these intervals descriptive, not subject-level confidence intervals.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:meanstd}{{III}{6}{SisFall main protocol, five-fold mean$\pm $sample std ($n{=}1000$/fold, fall prevalence $0.433{\pm }0.004$), computed from the counts in Table~\ref {tab:confusion} before rounding. Paired intervals are fold-level percentile bootstrap ($10^4$ resamples, seed $42$); BCa intervals are F1 $[0.117,0.154]$, recall $[0.181,0.244]$, cost $[-1084,-834]$. The exact two-sided Wilcoxon $p$ is $0.0625$ for every metric (the minimum attainable with five pairs). Five overlapping folds make these intervals descriptive, not subject-level confidence intervals}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Author-supplied main-ablation confusion counts on SisFall ($n{=}1000$/fold), with metrics recomputed before rounding. These supplied counts confirm the earlier integer reconstruction, including $437$ falls in folds\nobreakspace  {}1 and\nobreakspace  {}3. They yield mean costs $1150.8$ and $199.8$. Counts are aggregate records, not independent verification of prediction files or case identity. The separate timing run differs by $+1$, $-1$ and $+2$ false positives in stack folds\nobreakspace  {}1, 3 and\nobreakspace  {}4 and is not mixed into this table.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:confusion}{{IV}{6}{Author-supplied main-ablation confusion counts on SisFall ($n{=}1000$/fold), with metrics recomputed before rounding. These supplied counts confirm the earlier integer reconstruction, including $437$ falls in folds~1 and~3. They yield mean costs $1150.8$ and $199.8$. Counts are aggregate records, not independent verification of prediction files or case identity. The separate timing run differs by $+1$, $-1$ and $+2$ false positives in stack folds~1, 3 and~4 and is not mixed into this table}{table.4}{}}
